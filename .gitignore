# =============================================================================
# Smart Teams / AMSSS — .gitignore
# NOTE: git only reads a file named ".gitignore". The pre-existing ".ignore"
# file is honored by ripgrep/fd, NOT by git, so it never protected anything.
# =============================================================================

# --- Secrets & environment ---------------------------------------------------
# These hold live credentials (DB password, JWT secret, SMTP app password).
.env
.env.*
**/.env
**/.env.*
!.env.example
*.local

# --- Personally identifiable information (PII) --------------------------------
# Local email simulation drops recipients' messages here as plaintext.
apps/admin/emails/
**/emails/
# Uploaded employee documents (offer letters, contracts, ID proof) — local
# disk storage backing the documents feature toggle, real PII.
apps/admin/uploads/
**/uploads/
# Local JSON fallback datastore contains real users/tenants/attendance.
**/db_fallback.json
**/db_fallback.json.*
**/*.corrupted-*

# --- Node ---------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# --- Build output -------------------------------------------------------------
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# --- Turborepo ----------------------------------------------------------------
.turbo/
**/.turbo/

# --- Logs & runtime -----------------------------------------------------------
*.log
logs/

# --- Python (services/face-service) --------------------------------------------
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc

# --- Editor / OS --------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Documentation / Artifacts ------------------------------------------------
RELEASE_NOTES.md
release_notes.md

# --- Dead one-off scratch scripts from early scaffolding ----------------------
# Confirmed unreferenced by any package.json/turbo.json script, CI workflow, or
# deploy config (render.yaml/fly.toml/vercel.json/docker-compose/Caddyfile) —
# get_wizard.sh even greps a src/components/EnterpriseSandbox.tsx that no
# longer exists. Kept out of the repo rather than left to look like part of
# the live build.
/check_drizzle_eq.ts
/create-packages.cjs
/fix-pnpm.cjs
/get_wizard.sh
/update-packages.cjs
/wait.sh
/test-build.sh

# --- Stale scaffold metadata ---------------------------------------------------
# Leftover from the project's original placeholder scaffold (same one the
# README already calls out for a stray GEMINI_API_KEY reference this app
# never used) — name "Perimeter", camera/geolocation framing, and a
# SERVER_SIDE_GEMINI_API capability claim that don't match the shipped
# WebAuthn-based product. Not read by any app code.
/metadata.json
